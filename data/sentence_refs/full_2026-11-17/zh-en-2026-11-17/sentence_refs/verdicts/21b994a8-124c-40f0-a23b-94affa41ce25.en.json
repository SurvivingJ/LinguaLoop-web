  "sentences": [
    {
      "idx": 0,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7937,
      "back_translation": "一个阳光明媚的早晨,在小女孩莉莉的房间里,书桌上坐着一个特别的玩具。"
    },
    {
      "idx": 1,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.6667,
      "back_translation": "它是一只名叫“熊熊”的毛绒泰迪熊。"
    },
    {
      "idx": 2,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8842,
      "back_translation": "熊熊看起来非常可爱:它的身体是棕色的,圆圆的眼睛闪着友善的光,黑色的鼻子总是微微向上翘着,好像在微笑。"
    },
    {
      "idx": 3,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8824,
      "back_translation": "熊熊最引人注目的是它穿着的毛衣。"
    },
    {
      "idx": 4,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9429,
      "back_translation": "这件毛衣是深蓝色的,毛线织得很柔软,上面还有一些小小的白色图案,像雪花一样。"
    },
    {
      "idx": 5,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8764,
      "back_translation": "莉莉非常喜欢这件蓝色毛衣,因为蓝色是她最喜欢的颜色,而且熊熊穿上这件毛衣后,看起来更温暖、更迷人了。"
    },
    {
      "idx": 6,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.88,
      "back_translation": "熊熊不只是一个普通的玩具。"
    },
    {
      "idx": 7,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9388,
      "back_translation": "对莉莉来说,它是一个忠实的伙伴,是可以倾诉心事的朋友。"
    },
    {
      "idx": 8,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7895,
      "back_translation": "每天放学回到家,莉莉把书包放到一边,然后跑到熊熊身边,把学校里发生的一切都和它分享。"
    },
    {
      "idx": 9,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.96,
      "back_translation": "她告诉熊熊今天学了什么新单词,和同学玩了什么游戏,或者有没有遇到什么不开心的事。"
    },
    {
      "idx": 10,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7925,
      "back_translation": "熊熊总是安静地听着;虽然它不会说话,莉莉却觉得它能听懂她。"
    },
    {
      "idx": 11,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7647,
      "back_translation": "莉莉房间里熊熊的蓝毛衣就像一片宁静的湖水,给莉莉带来许多安慰和快乐。"
    },
    {
      "idx": 12,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8837,
      "back_translation": "这只泰迪熊是奶奶在莉莉三岁生日时送给她的礼物。"
    },
    {
      "idx": 13,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8837,
      "back_translation": "从那以后,熊熊成了莉莉生活中不可或缺的一部分。"
    },
    {
      "idx": 14,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8108,
      "back_translation": "它陪着莉莉长大,陪她度过了无数个日日夜夜。"
    },
    {
      "idx": 15,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8462,
      "back_translation": "生病的时候,莉莉紧紧抱着熊熊,感受到它传来的温暖力量。"
    },
    {
      "idx": 16,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9455,
      "back_translation": "害怕打雷的时候,莉莉把脸埋在熊熊柔软的毛里,直到不再害怕。"
    },
    {
      "idx": 17,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8205,
      "back_translation": "熊熊的蓝毛衣也见证了莉莉许多成长的时刻。"
    },
    {
      "idx": 18,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9167,
      "back_translation": "有时候,莉莉会亲自给熊熊换上别的衣服,但最后她总是把这件蓝毛衣重新给熊熊穿上,因为这是她最喜爱的样子。"
    },
    {
      "idx": 19,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.875,
      "back_translation": "熊熊的蓝毛衣并不是一直这么干净。"
    },
    {
      "idx": 20,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9434,
      "back_translation": "有一次,莉莉在公园里玩,不小心把冰淇淋掉到了熊熊的毛衣上。"
    },
    {
      "idx": 21,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9545,
      "back_translation": "冰淇淋融化后,在蓝毛衣上留下了一块黄色的污渍。"
    },
    {
      "idx": 22,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8387,
      "back_translation": "莉莉当时非常着急,她怕熊熊会变丑。"
    },
    {
      "idx": 23,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9268,
      "back_translation": "但是妈妈安慰了她,并教她如何小心地清洗毛衣。"
    },
    {
      "idx": 24,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9388,
      "back_translation": "在妈妈的帮助下,莉莉用温水和一点肥皂轻轻擦拭污渍。"
    },
    {
      "idx": 25,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8923,
      "back_translation": "经过一番努力,冰淇淋的污渍终于消失了,熊熊的蓝毛衣恢复了原来的样子。"
    },
    {
      "idx": 26,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.92,
      "back_translation": "这次经历让莉莉明白,即使是心爱的玩具,也需要细心爱护。"
    },
    {
      "idx": 27,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8308,
      "back_translation": "熊熊和它的蓝毛衣不只是莉莉的玩具,更是她童年回忆中最美好的一部分。"
    },
    {
      "idx": 28,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9024,
      "back_translation": "每当莉莉再长大一点,看到熊熊,她就会想起和它一起度过的时光,想起它身上那件温暖的蓝毛衣。"
    },
    {
      "idx": 29,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.92,
      "back_translation": "这件衣服就像一个无声的象征,代表着爱、陪伴和童年的纯真。"
    },
    {
      "idx": 30,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8889,
      "back_translation": "在莉莉的房间里,熊熊总是坐在显眼的位置,它的蓝毛衣在阳光下闪着柔和的光,好像在讲述一个关于友谊和成长的动人故事。"
    },
    {
      "idx": 31,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9333,
      "back_translation": "它是一个毛绒玩具,一件蓝毛衣,更是一份承载着满满回忆的珍贵宝藏。"
    }
  ]
