   "idx": 0,
   "back": "飞机在天上飞。"
  },
  {
   "idx": 1,
   "back": "它有翅膀。"
  },
  {
   "idx": 2,
   "back": "空气沿着翅膀的下面和上面流过。"
  },
  {
   "idx": 3,
   "back": "下面的空气用力推翅膀，让飞机向上升。"
  },
  {
   "idx": 4,
   "back": "这种力叫升力。"
  },
  {
   "idx": 5,
   "back": "飞机向前走的时候，空气不让它跑得快，这叫阻力。"
  },
  {
   "idx": 6,
   "back": "飞机要飞起来，需要大的升力和小的阻力。"
  },
  {
   "idx": 7,
   "back": "工程师研究物理，想办法让飞机飞得好。"
  },
  {
   "idx": 8,
   "back": "他们设计翅膀的形状。"
  },
  {
   "idx": 9,
   "back": "好的设计让飞机飞得安全。"
  }
 ]
