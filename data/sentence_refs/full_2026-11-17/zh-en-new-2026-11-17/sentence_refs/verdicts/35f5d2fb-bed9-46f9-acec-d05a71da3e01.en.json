      "idx": 6,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7302,
      "back_translation": "许多人凭直觉认为接近百分之九十，但实际上，经过计算，后验概率只有大约百分之九。"
    },
