      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8148,
      "back_translation": "定期翻堆以确保氧气渗透、防止局部厌氧酸化，是维持微生物群落活性的关键操作。"
    },
    {
