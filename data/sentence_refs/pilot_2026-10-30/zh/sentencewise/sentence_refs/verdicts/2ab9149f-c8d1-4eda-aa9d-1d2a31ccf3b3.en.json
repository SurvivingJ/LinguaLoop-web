    {
      "idx": 3,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9787,
      "back_translation": "每天早上，人们带着树苗和水桶来到公园，挖坑、种树、浇水。"
    },
    {
      "idx": 4,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 1.0,
      "back_translation": "虽然有时候很累，但是大家都很开心。"
