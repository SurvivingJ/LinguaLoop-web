  {
   "idx": 0,
   "back": "不同地方的人对时间的看法不同。"
  },
  {
   "idx": 1,
   "back": "有些人喜欢准时。"
  },
  {
   "idx": 2,
   "back": "对于约会或上课,他们会提前到。"
  },
  {
   "idx": 3,
   "back": "这就是守时。"
  },
  {
   "idx": 4,
   "back": "有些人慢悠悠的。"
  },
  {
   "idx": 5,
   "back": "对时间有不同的想法也没关系。"
  },
  {
   "idx": 6,
   "back": "每个人都有自己的习惯。"
  },
  {
   "idx": 7,
   "back": "有些人把日程写下来,每天都看。"
  },
  {
   "idx": 8,
   "back": "有些人把事情记在脑子里,不写下来。"
  },
  {
   "idx": 9,
   "back": "现在世界是互相联系的。"
  },
  {
   "idx": 10,
   "back": "全球化让不同文化的人经常见面。"
  },
  {
   "idx": 11,
   "back": "大家需要互相理解。"
  },
  {
   "idx": 12,
   "back": "你守时,我尊重你。"
  },
  {
   "idx": 13,
   "back": "我慢悠悠的,所以请不要生我的气。"
  },
  {
   "idx": 14,
   "back": "这样,大家都开心。"
  }
 ]
