  "sentences": [
    {
      "idx": 0,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9524,
      "back_translation": "全球咖啡豆供应链是当代国际贸易体系中最复杂的大宗商品流通网络之一。"
    },
    {
      "idx": 1,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9011,
      "back_translation": "作为全球贸易量最大的农产品之一，咖啡豆的流动贯穿了从热带农业种植到全球城市消费终端的漫长链条。"
    },
    {
      "idx": 2,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.896,
      "back_translation": "在南纬25度到北纬25度之间的“咖啡带”内，数十个发展中国家以小农经济与大型种植园并存的模式种植咖啡，构成了全球农业供应的基础环节。"
    },
    {
      "idx": 3,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8571,
      "back_translation": "这些原产国，如拉丁美洲的安第斯山麓、东非高原和东南亚的火山群岛，依靠其独特的小气候和海拔条件，培育出具有地域风味特征的咖啡豆品种，其中阿拉比卡和罗布斯塔是两大主要类型。"
    },
    {
      "idx": 4,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7143,
      "back_translation": "咖啡果采摘后，须经过水洗、日晒或蜜处理等加工方式，再经过脱壳、分拣和预烘焙处理，最后以“生豆”的形式进入出口环节。"
    },
    {
      "idx": 5,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8471,
      "back_translation": "出口环节通常由跨国贸易公司主导，它们通过期货市场和长期合同锁定价格，并将生豆大批量运往消费国。"
    },
    {
      "idx": 6,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.789,
      "back_translation": "这一过程涉及多个中间商、公平贸易和有机认证等质量认证体系以及复杂的物流协调，以确保从原产地仓库到目的港的供应链稳定。"
    },
    {
      "idx": 7,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7097,
      "back_translation": "值得注意的是，虽然原产国承担了种植和初级加工等劳动密集型工作，但它们在最终价值链中获得的收益份额长期偏低，形成了典型的“初级商品依赖”困境。"
    },
    {
      "idx": 8,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8571,
      "back_translation": "相比之下，北美、西欧和东亚部分高收入经济体作为主要进口方，凭借资本和品牌优势，掌控着烘焙、包装和市场分销渠道。"
    },
    {
      "idx": 9,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 1.0,
      "back_translation": "进口国的消费市场呈现出高度分化的格局。"
    },
    {
      "idx": 10,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8159,
      "back_translation": "一方面，大众零售市场依赖大规模生产的速溶咖啡和连锁咖啡店的标准化产品；另一方面，精品咖啡运动的兴起推动了“从种子到杯子”的可追溯理念，消费者越来越关注产地故事、加工工艺和风味特征，这反过来又影响了原产地的种植方式和分级标准。"
    },
    {
      "idx": 11,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9057,
      "back_translation": "这种消费升级不仅重塑了贸易结构，还催生了直接贸易和订单农业等新的合作模式，试图缩短供应链层级，提高生产者的议价能力。"
    },
    {
      "idx": 12,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9032,
      "back_translation": "然而，这一体系仍面临多重结构性挑战。"
    },
    {
      "idx": 13,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8862,
      "back_translation": "气候变化导致适宜种植区缩小，频繁的极端天气影响产量稳定；全球航运成本波动、地缘政治紧张局势和关税政策调整都可能扰乱贸易流动；同时，小农户在面对市场风险时普遍缺乏金融工具和信息支持。"
    },
    {
      "idx": 14,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9138,
      "back_translation": "近年来，一些国际组织和私营企业开始推广数字农业解决方案，如卫星遥感监测、区块链溯源和移动支付平台，以增强供应链的透明度和韧性。"
    },
    {
      "idx": 15,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8905,
      "back_translation": "从宏观角度看，咖啡豆的全球流动不仅反映了农业资源禀赋与消费欲望之间的空间错配，也揭示了全球化背景下公平贸易、可持续发展和伦理消费等深层问题的博弈。"
    },
    {
      "idx": 16,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9444,
      "back_translation": "这条链条上的每一个环节，都在不断重新定义生产者与消费者之间的经济和道德关系。"
    }
  ]
