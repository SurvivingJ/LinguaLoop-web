  "sentences": [
    {
      "idx": 0,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 1.0,
      "back_translation": "在我的房间里，有一个特别的玩具。"
    },
    {
      "idx": 1,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 1.0,
      "back_translation": "它是一只毛绒泰迪熊。"
    },
    {
      "idx": 2,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9231,
      "back_translation": "这只熊很可爱，它的身体软软的，摸起来很舒服。"
    },
    {
      "idx": 3,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9744,
      "back_translation": "它最特别的地方是穿着一件漂亮的蓝色毛衣。"
    },
    {
      "idx": 4,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8571,
      "back_translation": "这件毛衣是它一直穿着的，颜色是很深的蓝色，像夏天的夜空。"
    },
    {
      "idx": 5,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 1.0,
      "back_translation": "这只泰迪熊是我的好朋友。"
    },
    {
      "idx": 6,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.6923,
      "back_translation": "每天晚上，我都抱着它睡觉。"
    },
    {
      "idx": 7,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8475,
      "back_translation": "它的眼睛是黑色的，鼻子是棕色的，看起来总是在笑，好像很高兴见到我。"
    },
    {
      "idx": 8,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8485,
      "back_translation": "它的耳朵圆圆的，毛茸茸的，摸起来很软。"
    },
    {
      "idx": 9,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9123,
      "back_translation": "它的爪子也很可爱，虽然是毛绒做的，但看起来很结实，我可以握住它们。"
    },
    {
      "idx": 10,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9091,
      "back_translation": "我记得刚得到这只熊的时候，我很开心。"
    },
    {
      "idx": 11,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8767,
      "back_translation": "那时候它还没有穿毛衣，妈妈说它看起来有点冷，就给我买了一件蓝色毛衣给它穿上。"
    },
    {
      "idx": 12,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9444,
      "back_translation": "从那以后，这只熊就一直穿着这件蓝毛衣。"
    },
    {
      "idx": 13,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9333,
      "back_translation": "这件毛衣的毛线很细，织得很密，冬天穿一定很暖和。"
    },
    {
      "idx": 14,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8235,
      "back_translation": "上面还有一些白色的小花纹，让这件毛衣看起来不那么单调。"
    },
    {
      "idx": 15,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7143,
      "back_translation": "这只熊不只是一个玩具，它还装着我的很多回忆。"
    },
    {
      "idx": 16,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.6667,
      "back_translation": "我难过的时候，抱着它，觉得它给了我安慰。"
    },
    {
      "idx": 17,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9412,
      "back_translation": "我开心的时候，也会和它分享我的快乐。"
    },
    {
      "idx": 18,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.878,
      "back_translation": "它总是安静地听我说话，好像真的能听懂我的话。"
    },
    {
      "idx": 19,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.963,
      "back_translation": "有时候我假装和它说话，它也会“回答”我，虽然那只是我自己的声音。"
    },
    {
      "idx": 20,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9756,
      "back_translation": "这只穿蓝毛衣的泰迪熊是我房间里最温馨的存在。"
    },
    {
      "idx": 21,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7917,
      "back_translation": "虽然它不能动，也不能说话，但它用自己独特的方式陪伴着我。"
    },
    {
      "idx": 22,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.95,
      "back_translation": "有时候我把它放在窗台上，让它看外面的世界。"
    },
    {
      "idx": 23,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.84,
      "back_translation": "它看小鸟在树上唱歌，看汽车在路上开，看云在天上飘。"
    },
    {
      "idx": 24,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9744,
      "back_translation": "我想它一定也很好奇外面的世界是什么样的。"
    },
    {
      "idx": 25,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.7097,
      "back_translation": "因为我经常抱它，这只熊的毛衣有一点点褪色了，但还是那么好看的蓝色。"
    },
    {
      "idx": 26,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.72,
      "back_translation": "它的毛也因为被摸久了，有些地方变得有点扁，但还是软软的。"
    },
    {
      "idx": 27,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.871,
      "back_translation": "我真的很喜欢这只穿蓝毛衣的泰迪熊，它是我的宝贝，也是我最亲密的伙伴。"
    },
    {
      "idx": 28,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.9455,
      "back_translation": "它是我童年不可缺少的一部分，也是我未来回忆里一个温暖的印记。"
    },
    {
      "idx": 29,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "Low tightness: 安全感/幸福感 vs 安心和快乐; \"a sense of security\" is an accepted rendering of 安心 here.",
      "tightness": 0.5294,
      "back_translation": "每次看到它，我都觉得有安全感和幸福感。"
    },
    {
      "idx": 30,
      "verdict": "pass",
      "entailment_ok": true,
      "changed": false,
      "notes": "",
      "tightness": 0.8364,
      "back_translation": "这只熊是我的一个小小的、毛茸茸的、穿蓝毛衣的、独一无二的朋友。"
    }
  ]
