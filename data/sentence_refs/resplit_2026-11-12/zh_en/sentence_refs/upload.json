      "idx": 13,
      "sentence_id": 4701,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "There was an elderly person who said, \"When I was little, there were many trees here; now we are returning the green to the city.\"",
      "author_model": "claude-sonnet-5-5",
