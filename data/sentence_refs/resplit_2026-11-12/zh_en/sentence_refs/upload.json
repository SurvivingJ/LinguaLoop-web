      "idx": 9,
      "sentence_id": 1481,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "This project is called \"Green Homeland\", and it is a good example of a local action.",
      "author_model": "claude-sonnet-5-5",
      "prompt_version": "sr-1.0",
