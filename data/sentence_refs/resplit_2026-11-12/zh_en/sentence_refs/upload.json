      "idx": 3,
      "sentence_id": 1475,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "Every morning, people come to the park carrying small saplings and buckets, dig holes, plant trees, and water them.",
      "author_model": "claude-sonnet-5-5",
      "prompt_version": "sr-1.0",
      "arm": "sentencewise",
