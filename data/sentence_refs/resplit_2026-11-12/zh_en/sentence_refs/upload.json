      "idx": 8,
      "sentence_id": 4700,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "What she meant is that only when different kinds of plants and animals can live together will nature be healthy.",
      "author_model": "claude-sonnet-5-5",
