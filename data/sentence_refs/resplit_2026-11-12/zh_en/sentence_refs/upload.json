      "idx": 4,
      "sentence_id": 1476,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "Although it is sometimes very tiring, everyone is very happy.",
      "author_model": "claude-sonnet-5-5",
      "prompt_version": "sr-1.0",
      "arm": "sentencewise",
      "reviewer_model": "claude-sonnet-5-5",
