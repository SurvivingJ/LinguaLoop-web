      "idx": 5,
      "sentence_id": 1477,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "Planting trees not only makes the city beautiful; it is also very important for ecological protection.",
      "author_model": "claude-sonnet-5-5",
      "prompt_version": "sr-1.0",
      "arm": "sentencewise",
      "reviewer_model": "claude-sonnet-5-5",
