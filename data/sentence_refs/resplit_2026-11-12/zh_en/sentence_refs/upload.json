      "idx": 12,
      "sentence_id": 1484,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "Although the city is developing very fast, we can also do a little something to protect the environment.",
      "author_model": "claude-sonnet-5-5",
      "prompt_version": "sr-1.0",
