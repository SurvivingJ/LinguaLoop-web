      "idx": 11,
      "sentence_id": 1483,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "Every person who takes part is a part of community building.",
      "author_model": "claude-sonnet-5-5",
      "prompt_version": "sr-1.0",
