      "idx": 7,
      "sentence_id": 4699,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "One teacher said, \"What we are planting is not only trees; we are restoring biodiversity.\"",
      "author_model": "claude-sonnet-5-5",
      "prompt_version": "sr-1.0",
      "arm": "sentencewise",
