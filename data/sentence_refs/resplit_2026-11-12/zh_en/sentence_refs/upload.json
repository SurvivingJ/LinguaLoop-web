      "idx": 14,
      "sentence_id": 4702,
      "l1": "en",
      "l1_language_id": 2,
      "l1_text": "Young people and children have also joined in; they learn knowledge about nature, and have also learned cooperation.",
      "author_model": "claude-sonnet-5-5",
