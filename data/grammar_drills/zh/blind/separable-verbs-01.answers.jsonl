{"id": "separable-verbs-01-044", "zh": "我想跟老师见面"}
{"id": "separable-verbs-01-045", "zh": "小王跟一个同事结婚了"}
{"id": "separable-verbs-01-046", "zh": "我应该向她道歉"}
{"id": "separable-verbs-01-047", "zh": "谢谢你帮了我的忙"}
{"id": "separable-verbs-01-048", "zh": "妈妈还在生我的气"}
{"id": "separable-verbs-01-049", "zh": "我们以前见过面"}
{"id": "separable-verbs-01-050", "zh": "他从来没请过假"}
{"id": "separable-verbs-01-051", "zh": "我昨天睡了八个小时觉"}
{"id": "separable-verbs-01-052", "zh": "他们已经离婚三年了"}
{"id": "separable-verbs-01-053", "zh": "为了准备考试，他昨天只睡了四个小时觉"}
{"id": "separable-verbs-01-054", "zh": "我们只见过两次面"}
{"id": "separable-verbs-01-055", "zh": "经理今天开了三个会"}
{"id": "separable-verbs-01-056", "zh": "我想先洗个澡"}
{"id": "separable-verbs-01-057", "zh": "周末我在家喜欢唱唱歌"}
{"id": "separable-verbs-01-058", "zh": "有空来我家聊聊天"}
{"id": "separable-verbs-01-059", "zh": "我昨天睡觉睡得很晚"}
{"id": "separable-verbs-01-060", "zh": "她唱歌唱得很好"}
{"id": "separable-verbs-01-061", "zh": "我吃完饭就去上课"}
{"id": "separable-verbs-01-062", "zh": "我昨晚没睡好觉"}
{"id": "separable-verbs-01-063", "zh": "下班以后我洗完澡就睡觉了"}
{"id": "separable-verbs-01-064", "zh": "我们见过面"}
{"id": "separable-verbs-01-065", "zh": "我睡了八个小时觉"}
{"id": "separable-verbs-01-066", "zh": "我们去公园散散步"}
{"id": "separable-verbs-01-067", "zh": "我想跟老师见面"}
{"id": "separable-verbs-01-068", "zh": "妈妈生我的气了"}
{"id": "separable-verbs-01-069", "zh": "他唱歌唱得很好"}
{"id": "separable-verbs-01-070", "zh": "他洗完澡就看书"}
{"id": "separable-verbs-01-071", "zh": "他结过两次婚"}
{"id": "separable-verbs-01-072", "zh": "我姐姐大学毕业三年了"}
{"id": "separable-verbs-01-073", "zh": "他向老师道歉了"}
